# Copia este archivo como .env y rellena lo que tengas. Sin clave funciona en modo local.
ANTHROPIC_API_KEY=
# Opcional: embeddings remotos (si no, TF-IDF local)
VOYAGE_API_KEY=
OPENAI_API_KEY=
# Modelos (por defecto Haiku para extraer y Sonnet para razonar)
FITIN_MODEL_FAST=claude-haiku-5-5
FITIN_MODEL_SMART=claude-sonnet-5-5
# Pon 1 para forzar el modo local aunque haya clave (wifi del evento caído)
FITIN_LOCAL=0
